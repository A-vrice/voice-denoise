{
  "name": "voice-denoise",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:bundle && bun run build:static",
    "build:bundle": "bun build --target browser --minify --splitting --outdir dist --sourcemap=external src/main.ts",
    "build:static": "bun scripts/build-static.ts",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
